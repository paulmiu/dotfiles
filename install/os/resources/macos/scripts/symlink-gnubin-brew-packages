#!/usr/bin/env bash
# Expose GNU names in a dedicated user directory, without overwriting Homebrew files.
set -Eeuo pipefail
GNUBIN_DIR="$HOME/.local/share/dotfiles/gnubin"
while (($#)); do
    case $1 in
        -d | --gnubin-dir)
            [[ $# -ge 2 && -n $2 ]] || {
                printf 'Missing directory.\n' >&2
                exit 1
            }
            GNUBIN_DIR=$2
            shift 2
            ;;
        --gnubin-dir=*)
            GNUBIN_DIR=${1#*=}
            shift
            ;;
        -h | --help)
            printf 'Usage: symlink-gnubin-brew-packages [--gnubin-dir PATH]\n'
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            exit 1
            ;;
    esac
done
[[ $GNUBIN_DIR == /* && $GNUBIN_DIR != / && ! -L $GNUBIN_DIR ]] || {
    printf 'Choose an absolute, dedicated directory.\n' >&2
    exit 1
}
prefix=$(brew --prefix)
prefix=$(cd "$prefix" && pwd -P)
mkdir -p "$GNUBIN_DIR"
GNUBIN_DIR=$(cd "$GNUBIN_DIR" && pwd -P)
case $GNUBIN_DIR in
    / | /bin | /sbin | /usr/bin | /usr/sbin | /usr/local/bin | /usr/local/sbin | "$prefix/bin" | "$prefix/sbin")
        printf 'Refusing to replace a system or Homebrew bin directory.\n' >&2
        exit 1
        ;;
esac
shopt -s nullglob
for file in "$prefix"/opt/*/libexec/gnubin/* "$prefix"/opt/python*/libexec/bin/*; do
    [[ -f $file && -x $file ]] || continue
    target="$GNUBIN_DIR/$(basename "$file")"
    if [[ -e $target || -L $target ]]; then
        [[ -L $target && $(readlink "$target") == "$prefix"/opt/* ]] || {
            printf 'Refusing to overwrite unrelated file: %s\n' "$target" >&2
            exit 1
        }
        rm "$target"
    fi
    ln -s "$file" "$target"
done
printf 'GNU command links installed in %s\n' "$GNUBIN_DIR"
